# Server
PORT=3000
NODE_ENV=development

# Required in production: a long random string (e.g. `openssl rand -hex 48`)
SESSION_SECRET=replace-this-with-a-long-random-secret-before-deploying

# Organizer login (created on first run; use `npm run reset-admin` to change later)
ADMIN_EMAIL=admin@caipsd.org
ADMIN_PASSWORD=ChangeMe123!

# How many days a ticket stays valid after it is issued
TICKET_VALID_DAYS=3

# ---- Email (optional but recommended): tickets are sent from YOUR mailbox ----
# Gmail: enable 2-Step Verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-character-app-password
# Display name shown to participants
MAIL_FROM_NAME=CAIPSD Events
# For non-Gmail providers also set: SMTP_HOST=smtp.example.com  SMTP_PORT=587  SMTP_SECURE=false
# Public address of this portal (adds an "Open ticket online" button to the email)
# APP_URL=https://tickets.example.com
# Time zone used when dates are written in emails
EVENT_TIMEZONE=Asia/Karachi

# Set to 1 when running behind a trusted reverse proxy (Nginx, Caddy, Cloudflare...)
# TRUST_PROXY=1

# Optional: custom SQLite file location (default: ./data/caipsd.sqlite)
# DB_PATH=./data/caipsd.sqlite
